[
    {
        "name": "本地AI答题助手",
        "homepage": "http://127.0.0.1:7077",
        "url": "http://127.0.0.1:7077/api/answer",
        "method": "post",
        "contentType": "json",
        "type": "GM_xmlhttpRequest",
        "data": {
            "type": "${type}",
            "question": "${title}",
            "options": "${options}",
            "key": ""
        },
        "headers": {
            "Content-Type": "application/json"
        },
        "handler": "return (res)=> res.code === 1 ? [undefined, res.answer] : undefined"
    }
]
